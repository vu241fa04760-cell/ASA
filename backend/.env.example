# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/ai_study_db
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_study_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=ai_study_assistant_super_secret_jwt_key_2026_production_ready
JWT_EXPIRE=30d

# AI Configuration (Google Gemini API)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
